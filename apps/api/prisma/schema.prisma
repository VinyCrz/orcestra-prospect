// Orce'estra Prospect — schema completo (Etapa 1 já prevê as entidades das próximas etapas).

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Papel {
  ADMIN
  GESTOR
  SDR
}

enum Regiao {
  NORTE
  NORDESTE
  CENTRO_OESTE
  SUDESTE
  SUL
}

/// Funil (Etapa 3). PERDIDA exige motivoPerdaId; NUTRICAO exige dataRetornoNutricao (validado na API).
enum StatusProspeccao {
  NAO_TRABALHADA
  PESQUISADA
  PRIMEIRO_CONTATO
  EM_CONVERSA
  REUNIAO_AGENDADA
  OPORTUNIDADE
  PERDIDA
  NUTRICAO
}

enum TipoTag {
  AREA
  CURSO
  LIVRE
}

/// Canal de interação e de passo de cadência (mesmo enum: o passo gera a interação no seu canal).
/// OUTRO existe por compatibilidade com cadências/templates; a API de interações aceita só os 7 primeiros.
enum Canal {
  EMAIL
  WHATSAPP
  LIGACAO
  LINKEDIN
  INSTAGRAM
  REUNIAO
  OUTRO
  EVENTO
}

/// Resultado da interação (base da "taxa de resposta por canal": tudo ≠ SEM_RESPOSTA conta como resposta).
enum ResultadoInteracao {
  SEM_RESPOSTA
  RESPONDEU
  REUNIAO_MARCADA
  NAO_INTERESSADO
  OUTRO
}

enum OrigemTarefa {
  MANUAL
  INTERACAO
  MANDATO_VENCENDO
  NUTRICAO_RETORNO
  CADENCIA
}

/// Inscrição de uma EJ numa cadência (Etapa 5). No máximo UMA ATIVA por EJ+cadência (índice único parcial).
enum StatusInscricao {
  ATIVA
  /// todos os passos executados
  CONCLUIDA
  /// interrompida antes do fim (ver motivoEncerramento)
  ENCERRADA
}

enum MotivoEncerramento {
  /// a EJ/contato respondeu (interação com resultado ≠ SEM_RESPOSTA)
  RESPOSTA
  /// a EJ avançou no funil (ou foi perdida/nutrição)
  AVANCO_FUNIL
  MANUAL
  /// o contato da inscrição entrou em opt-out
  OPT_OUT
}

enum StatusImportacao {
  /// arquivo recebido; aguardando mapeamento de colunas / pré-visualização / confirmação
  AGUARDANDO_MAPEAMENTO
  /// confirmada e enfileirada no BullMQ
  PENDENTE
  PROCESSANDO
  CONCLUIDA
  FALHOU
  CANCELADA
}

enum TipoImportacao {
  EJS
  CONTATOS
}

enum EstrategiaDuplicados {
  /// atualiza só campos vazios/novos do registro existente
  MESCLAR
  /// mantém o registro existente intacto e conta a linha como ignorada
  IGNORAR
}

enum CargoContato {
  PRESIDENTE
  DIR_GENTE_GESTAO
  DIR_COMERCIAL
  DIR_PROJETOS
  OUTRO
}

/// Bases legais da LGPD (art. 7º) aplicáveis a contatos B2B
enum BaseLegal {
  LEGITIMO_INTERESSE_B2B
  CONSENTIMENTO
  EXECUCAO_CONTRATO
  OBRIGACAO_LEGAL
}

/// Faixa do score de ICP (Etapa 4). Limiares configuráveis em ConfigScore.
enum FaixaIcp {
  A
  B
  C
  D
}

/// Natureza administrativa da IES. null = desconhecida (nada inventado).
enum NaturezaIes {
  PUBLICA
  PRIVADA
}

/// Chave estável dos critérios do score (o cálculo é código; adicionar critério exige migration + código).
enum CriterioIcp {
  FEDERADA
  FAIXA_MEMBROS
  AREAS_ALINHADAS
  REGIAO_PRIORITARIA
  IES_PUBLICA_PRIVADA
  TEM_SITE_REDES
  TEM_DECISOR
  INTERACAO_30D
  DADOS_VERIFICADOS
}

model Usuario {
  id            String    @id @default(cuid())
  nome          String
  email         String    @unique
  senhaHash     String
  papel         Papel     @default(SDR)
  ativo         Boolean   @default(true)
  ultimoLoginEm DateTime?
  criadoEm      DateTime  @default(now())
  atualizadoEm  DateTime  @updatedAt

  refreshTokens         RefreshToken[]
  tokensRedefinicao     TokenRedefinicaoSenha[]
  empresasResponsavel   EmpresaJunior[]         @relation("ResponsavelEj")
  interacoes            Interacao[]
  tarefasResponsavel    Tarefa[]                @relation("TarefaResponsavel")
  tarefasCriadas        Tarefa[]                @relation("TarefaCriador")
  historicoStatus       HistoricoStatus[]
  cadencias             Cadencia[]
  templates             TemplateMensagem[]
  listas                ListaSalva[]
  importacoes           Importacao[]
  auditLogs             AuditLog[]
  configScore           ConfigScore[]
  criteriosScore        CriterioScore[]
  inscricoesResponsavel InscricaoCadencia[]     @relation("InscricaoResponsavel")
  inscricoesFeitas      InscricaoCadencia[]     @relation("InscricaoInscritoPor")
  metasSemanais         MetaSemanal[]           @relation("MetaDoUsuario")
  metasDefinidas        MetaSemanal[]           @relation("MetaDefinidaPor")
  conquistas            ConquistaUsuario[]
  supressoesCriadas     SupressaoContato[]
  historicoOptOut       HistoricoOptOut[]

  @@map("usuarios")
}

model RefreshToken {
  id         String    @id @default(cuid())
  usuarioId  String
  tokenHash  String    @unique
  expiraEm   DateTime
  revogadoEm DateTime?
  criadoEm   DateTime  @default(now())
  userAgent  String?

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@map("refresh_tokens")
}

model TokenRedefinicaoSenha {
  id        String    @id @default(cuid())
  usuarioId String
  tokenHash String    @unique
  expiraEm  DateTime
  usadoEm   DateTime?
  criadoEm  DateTime  @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@map("tokens_redefinicao_senha")
}

model Federacao {
  id           String   @id @default(cuid())
  nome         String
  sigla        String   @unique
  uf           String?  @db.Char(2)
  site         String?
  instagram    String?
  fonteUrl     String?
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  nucleos  Nucleo[]
  empresas EmpresaJunior[]

  @@map("federacoes")
}

model Nucleo {
  id           String   @id @default(cuid())
  nome         String
  federacaoId  String?
  cidade       String?
  uf           String?  @db.Char(2)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  federacao Federacao?      @relation(fields: [federacaoId], references: [id])
  empresas  EmpresaJunior[]

  @@unique([nome, federacaoId])
  @@map("nucleos")
}

model Ies {
  id           String       @id @default(cuid())
  nome         String
  /// nome normalizado + UF — usado para deduplicar
  chave        String       @unique
  sigla        String?
  cidade       String?
  uf           String?      @db.Char(2)
  /// pública/privada (critério IES_PUBLICA_PRIVADA); preenchido pelo coletor ou edição, nunca deduzido
  natureza     NaturezaIes?
  criadoEm     DateTime     @default(now())
  atualizadoEm DateTime     @updatedAt

  empresas EmpresaJunior[]

  @@index([uf])
  @@map("ies")
}

model EmpresaJunior {
  id                    String           @id @default(cuid())
  nome                  String
  nomeNormalizado       String
  /// CNPJ ou nome+IES+UF normalizados (idempotência do seed / deduplicação)
  chaveDedupe           String           @unique
  razaoSocial           String?
  cnpj                  String?          @unique @db.Char(14)
  iesId                 String?
  federacaoId           String?
  nucleoId              String?
  cidade                String?
  uf                    String?          @db.Char(2)
  regiao                Regiao?
  servicos              String[]         @default([])
  anoFundacao           Int?
  membrosEstimados      Int?
  federada              Boolean          @default(false)
  site                  String?
  instagram             String?
  linkedin              String?
  facebook              String?
  emailInstitucional    String?
  telefoneInstitucional String?
  situacaoCadastral     String?
  idBrasilJunior        String?
  fonteUrl              String
  fontes                String[]         @default([])
  coletadoEm            DateTime
  verificado            Boolean          @default(false)
  statusProspeccao      StatusProspeccao @default(NAO_TRABALHADA)
  /// última mudança de status (tempo na etapa atual); backfill = criadoEm
  statusAlteradoEm      DateTime         @default(now())
  /// obrigatório quando status = PERDIDA (validado na API)
  motivoPerdaId         String?
  motivoPerdaDetalhe    String?
  /// obrigatório quando status = NUTRICAO; o job diário gera tarefa NUTRICAO_RETORNO
  dataRetornoNutricao   DateTime?        @db.Date
  /// 0–100 (CHECK no banco). Calculado pelo job de score; 0 + faixaIcp null = ainda não calculado
  scoreIcp              Int              @default(0)
  /// null = score ainda não calculado
  faixaIcp              FaixaIcp?
  /// [{ chave, nome, peso, pontos, motivo }] — explicação exibida na página da EJ
  scoreDetalhe          Json?
  scoreCalculadoEm      DateTime?
  /// ConfigScore.versao usada no cálculo; recálculo em massa = WHERE scoreVersao IS DISTINCT FROM versao atual
  scoreVersao           Int?
  responsavelId         String?
  observacoes           String?
  /// Tem alguma forma de contato (só essas aparecem no sistema; as demais ficam ocultas, nunca apagadas).
  /// MANTIDO PELO BANCO (migration ej_tem_contato), não escreva pela API: o trigger BEFORE INSERT/UPDATE
  /// recalcula sempre e o trigger em contatos recalcula a EJ afetada. Regra (função ej_tem_contato):
  /// site/instagram/linkedin/facebook/emailInstitucional/telefoneInstitucional preenchido (não null nem
  /// só espaços) OU contato com optOut = false, anonimizadoEm null e email/telefone/whatsapp/linkedin preenchido.
  temContato            Boolean          @default(false)
  criadoEm              DateTime         @default(now())
  atualizadoEm          DateTime         @updatedAt

  ies                Ies?                @relation(fields: [iesId], references: [id])
  federacao          Federacao?          @relation(fields: [federacaoId], references: [id])
  nucleo             Nucleo?             @relation(fields: [nucleoId], references: [id])
  responsavel        Usuario?            @relation("ResponsavelEj", fields: [responsavelId], references: [id])
  motivoPerda        MotivoPerda?        @relation(fields: [motivoPerdaId], references: [id], onDelete: Restrict)
  tags               Tag[]
  contatos           Contato[]
  interacoes         Interacao[]
  tarefas            Tarefa[]
  historicoStatus    HistoricoStatus[]
  inscricoesCadencia InscricaoCadencia[]

  /// EJs por UF / funil por UF (dashboard, index-only); também serve o filtro só por UF
  @@index([uf, statusProspeccao])
  @@index([motivoPerdaId])
  /// job diário de retorno de nutrição
  @@index([dataRetornoNutricao])
  @@index([regiao])
  /// cobertura por federação (% status ≠ NAO_TRABALHADA, index-only); também serve o filtro só por federação
  @@index([federacaoId, statusProspeccao])
  @@index([iesId])
  @@index([nucleoId])
  @@index([nomeNormalizado])
  @@index([statusProspeccao])
  /// carteira do SDR / "sem responsável" (IS NULL) / carga por UF no rodízio
  @@index([responsavelId, uf])
  @@index([scoreIcp(sort: Desc), nome])
  /// filtro por faixa ordenado por score
  @@index([faixaIcp, scoreIcp(sort: Desc)])
  /// "Prioridades da semana": responsavelId = :sdr AND statusProspeccao = NAO_TRABALHADA ORDER BY scoreIcp DESC LIMIT n
  @@index([responsavelId, statusProspeccao, scoreIcp(sort: Desc)])
  @@index([membrosEstimados])
  /// temContato = true em toda consulta visível. Kanban: coluna por status ORDER BY score DESC, nome LIMIT n
  /// (sem sort) + contagem por status/funil (index-only)
  @@index([temContato, statusProspeccao, scoreIcp(sort: Desc), nome])
  /// dashboard "EJs por UF"/funil por UF e filtro por UF (index-only)
  @@index([temContato, uf, statusProspeccao])
  /// lista padrão (ORDER BY nome LIMIT n, sem sort)
  @@index([temContato, nome])
  /// busca por trecho (ILIKE '%...%') — requer extensão pg_trgm (criada na migration etapa2)
  @@index([nome(ops: raw("gin_trgm_ops"))], type: Gin, map: "empresas_juniores_nome_trgm_idx")
  @@index([nomeNormalizado(ops: raw("gin_trgm_ops"))], type: Gin, map: "empresas_juniores_nomeNormalizado_trgm_idx")
  @@index([razaoSocial(ops: raw("gin_trgm_ops"))], type: Gin, map: "empresas_juniores_razaoSocial_trgm_idx")
  @@map("empresas_juniores")
}

model Tag {
  id       String   @id @default(cuid())
  nome     String
  tipo     TipoTag  @default(LIVRE)
  /// tipo + nome normalizado
  chave    String   @unique
  cor      String?
  criadoEm DateTime @default(now())

  empresas EmpresaJunior[]

  @@map("tags")
}

/// Pessoas de contato das EJs (LGPD: toda linha tem base legal e fonte; opt-out bloqueia o uso).
model Contato {
  id              String       @id @default(cuid())
  empresaJuniorId String
  nome            String
  cargo           CargoContato @default(OUTRO)
  /// texto livre quando cargo = OUTRO (ou detalhe do cargo)
  cargoDescricao  String?
  /// sempre minúsculo/trim (normalizado na aplicação)
  email           String?
  telefone        String?
  whatsapp        String?
  linkedin        String?
  principal       Boolean      @default(false)
  mandatoInicio   DateTime?    @db.Date
  mandatoFim      DateTime?    @db.Date
  baseLegal       BaseLegal    @default(LEGITIMO_INTERESSE_B2B)
  /// de onde veio o dado (URL, "importação <id>", "manual", ...)
  fonte           String?
  optOut          Boolean      @default(false)
  optOutEm        DateTime?
  optOutMotivo    String?
  /// LGPD: preenchido quando os dados pessoais foram anonimizados (Etapa 7)
  anonimizadoEm   DateTime?
  criadoEm        DateTime     @default(now())
  atualizadoEm    DateTime     @updatedAt

  empresaJunior      EmpresaJunior       @relation(fields: [empresaJuniorId], references: [id], onDelete: Cascade)
  interacoes         Interacao[]
  tarefas            Tarefa[]
  inscricoesCadencia InscricaoCadencia[]
  historicoOptOut    HistoricoOptOut[]

  @@index([empresaJuniorId])
  /// alertas de mandato vencendo (Etapa 3)
  @@index([mandatoFim])
  /// deduplicação na importação de contatos / busca por e-mail
  @@index([email])
  @@map("contatos")
}

/// Motivos de perda (lista configurável pelo ADMIN). Desative em vez de apagar (FK Restrict).
model MotivoPerda {
  id           String   @id @default(cuid())
  nome         String   @unique
  /// chave estável dos motivos do seed (idempotência sem sobrescrever renomeações); null = criado na UI
  chave        String?  @unique
  ativo        Boolean  @default(true)
  ordem        Int      @default(0)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  empresas        EmpresaJunior[]
  historicoStatus HistoricoStatus[]

  @@index([ativo, ordem])
  @@map("motivos_perda")
}

/// Toda mudança de status da EJ (timeline e "tempo médio por etapa"). Imutável: só criadoEm.
model HistoricoStatus {
  id              String            @id @default(cuid())
  empresaJuniorId String
  /// null = estado inicial (cadastro)
  de              StatusProspeccao?
  para            StatusProspeccao
  usuarioId       String?
  /// texto livre (ex.: detalhe da perda, origem "kanban"/"massa")
  motivo          String?
  motivoPerdaId   String?
  criadoEm        DateTime          @default(now())

  empresaJunior EmpresaJunior @relation(fields: [empresaJuniorId], references: [id], onDelete: Cascade)
  usuario       Usuario?      @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  motivoPerda   MotivoPerda?  @relation(fields: [motivoPerdaId], references: [id], onDelete: Restrict)

  /// timeline da EJ e "tempo na etapa" (linha anterior da mesma EJ via LATERAL ... ORDER BY criadoEm DESC LIMIT 1)
  @@index([empresaJuniorId, criadoEm])
  /// funil do período: WHERE criadoEm ∈ [ini, fim) GROUP BY para, count(DISTINCT ej) — index-only
  @@index([criadoEm, para, empresaJuniorId])
  /// motivos de perda no período: para = PERDIDA AND criadoEm ∈ período GROUP BY motivoPerdaId — index-only
  @@index([para, criadoEm, motivoPerdaId])
  @@index([motivoPerdaId])
  /// FK SetNull + conquista PRIMEIRA_OPORTUNIDADE (usuarioId = :sdr AND para = OPORTUNIDADE)
  @@index([usuarioId, para])
  @@map("historico_status")
}

model Interacao {
  id                  String             @id @default(cuid())
  empresaJuniorId     String
  contatoId           String?
  usuarioId           String?
  canal               Canal
  data                DateTime           @default(now())
  resumo              String?
  resultado           ResultadoInteracao @default(SEM_RESPOSTA)
  proximoPasso        String?
  proximoPassoData    DateTime?
  /// tarefa criada a partir do próximo passo (1:1)
  tarefaId            String?            @unique
  passoCadenciaId     String?
  /// inscrição de cadência cujo passo gerou esta interação (métricas por cadência)
  inscricaoCadenciaId String?
  criadoEm            DateTime           @default(now())
  atualizadoEm        DateTime           @updatedAt

  empresaJunior     EmpresaJunior      @relation(fields: [empresaJuniorId], references: [id], onDelete: Cascade)
  contato           Contato?           @relation(fields: [contatoId], references: [id], onDelete: SetNull)
  usuario           Usuario?           @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  tarefa            Tarefa?            @relation("TarefaDaInteracao", fields: [tarefaId], references: [id], onDelete: SetNull)
  passoCadencia     PassoCadencia?     @relation(fields: [passoCadenciaId], references: [id], onDelete: SetNull)
  inscricaoCadencia InscricaoCadencia? @relation(fields: [inscricaoCadenciaId], references: [id], onDelete: SetNull)

  @@index([empresaJuniorId, data])
  /// visão do SDR: progresso da meta / interações e resposta por canal no período (index-only)
  @@index([usuarioId, data, canal, resultado])
  /// visão do time: WHERE data ∈ [ini, fim) GROUP BY usuarioId | canal, resultado (ranking, taxa de resposta) — index-only.
  /// Substitui (canal, data): sem skip scan no PG16, data à frente atende o período com ou sem filtro de canal.
  @@index([data, usuarioId, canal, resultado])
  @@index([inscricaoCadenciaId])
  @@map("interacoes")
}

model Tarefa {
  id                  String       @id @default(cuid())
  titulo              String
  descricao           String?
  vencimento          DateTime
  concluida           Boolean      @default(false)
  concluidaEm         DateTime?
  /// cancelada (ex.: cadência encerrada): grava-se concluida = true + canceladaEm, então some da agenda
  /// sem mudar as consultas existentes; métricas de "concluídas" devem filtrar canceladaEm IS NULL
  canceladaEm         DateTime?
  adiadaVezes         Int          @default(0)
  origem              OrigemTarefa @default(MANUAL)
  /// idempotência dos jobs (ex.: "mandato:<contatoId>:<mandatoFim>", "nutricao:<ejId>:<data>")
  chaveIdempotencia   String?      @unique
  responsavelId       String
  empresaJuniorId     String?
  contatoId           String?
  criadoPorId         String?
  passoCadenciaId     String?
  /// inscrição que gerou a tarefa (origem = CADENCIA)
  inscricaoCadenciaId String?
  criadoEm            DateTime     @default(now())
  atualizadoEm        DateTime     @updatedAt

  /// usuários são desativados, não apagados — Restrict evita perder a agenda
  responsavel       Usuario            @relation("TarefaResponsavel", fields: [responsavelId], references: [id], onDelete: Restrict)
  empresaJunior     EmpresaJunior?     @relation(fields: [empresaJuniorId], references: [id], onDelete: Cascade)
  contato           Contato?           @relation(fields: [contatoId], references: [id], onDelete: SetNull)
  criadoPor         Usuario?           @relation("TarefaCriador", fields: [criadoPorId], references: [id], onDelete: SetNull)
  passoCadencia     PassoCadencia?     @relation(fields: [passoCadenciaId], references: [id], onDelete: SetNull)
  /// SetNull: a inscrição não é apagada no fluxo normal (encerra-se); se for, a agenda/histórico fica
  inscricaoCadencia InscricaoCadencia? @relation(fields: [inscricaoCadenciaId], references: [id], onDelete: SetNull)
  interacao         Interacao?         @relation("TarefaDaInteracao")

  /// no máximo uma tarefa por passo em cada inscrição (idempotência da geração; NULLs não colidem)
  @@unique([inscricaoCadenciaId, passoCadenciaId])
  /// "Minha agenda" (hoje/atrasadas/7 dias) e contador de atrasadas
  @@index([responsavelId, concluida, vencimento])
  /// tarefas pendentes de uma inscrição (encerrar cadência) e "próximo passo" da inscrição
  @@index([inscricaoCadenciaId, concluida, vencimento])
  /// timeline da EJ
  @@index([empresaJuniorId, criadoEm])
  @@map("tarefas")
}

/// Cadência global (só ADMIN edita). Desative (ativa = false) em vez de apagar: inscrições têm FK Restrict.
model Cadencia {
  id           String   @id @default(cuid())
  nome         String
  /// chave estável das cadências do seed (idempotência sem sobrescrever edições); null = criada na UI
  chave        String?  @unique
  descricao    String?
  ativa        Boolean  @default(true)
  criadoPorId  String?
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  criadoPor  Usuario?            @relation(fields: [criadoPorId], references: [id], onDelete: SetNull)
  passos     PassoCadencia[]
  inscricoes InscricaoCadencia[]

  @@map("cadencias")
}

/// EJ inscrita numa cadência. Inscrever gera uma Tarefa (origem CADENCIA) por passo; responder/avançar
/// no funil/opt-out encerra (status ENCERRADA + motivo) e cancela as tarefas pendentes.
/// CHECK no banco: ATIVA ⇔ encerradaEm IS NULL; ENCERRADA exige motivoEncerramento; demais status sem motivo.
/// Único parcial no banco: (empresaJuniorId, cadenciaId) WHERE status = 'ATIVA'.
model InscricaoCadencia {
  id                 String              @id @default(cuid())
  empresaJuniorId    String
  cadenciaId         String
  /// destinatário das mensagens (opcional; se em opt-out, a API bloqueia/encerra)
  contatoId          String?
  responsavelId      String
  inscritoPorId      String?
  /// base do vencimento das tarefas: iniciadaEm + passo.diaOffset
  iniciadaEm         DateTime            @default(now())
  status             StatusInscricao     @default(ATIVA)
  motivoEncerramento MotivoEncerramento?
  motivoDetalhe      String?
  encerradaEm        DateTime?
  criadoEm           DateTime            @default(now())
  atualizadoEm       DateTime            @updatedAt

  empresaJunior EmpresaJunior @relation(fields: [empresaJuniorId], references: [id], onDelete: Cascade)
  cadencia      Cadencia      @relation(fields: [cadenciaId], references: [id], onDelete: Restrict)
  contato       Contato?      @relation(fields: [contatoId], references: [id], onDelete: SetNull)
  /// usuários são desativados, não apagados
  responsavel   Usuario       @relation("InscricaoResponsavel", fields: [responsavelId], references: [id], onDelete: Restrict)
  inscritoPor   Usuario?      @relation("InscricaoInscritoPor", fields: [inscritoPorId], references: [id], onDelete: SetNull)
  tarefas       Tarefa[]
  interacoes    Interacao[]

  /// inscrições (ativas) da EJ — página da EJ e encerramento ao responder/avançar no funil
  @@index([empresaJuniorId, status])
  /// inscritos de uma cadência por status (tela da cadência)
  @@index([cadenciaId, status, iniciadaEm])
  /// "minhas cadências ativas"
  @@index([responsavelId, status])
  /// encerrar inscrições ao dar opt-out no contato
  @@index([contatoId])
  @@map("inscricoes_cadencia")
}

/// CHECK no banco: ordem ≥ 1, diaOffset ≥ 0. template.canal = passo.canal é validado na API.
model PassoCadencia {
  id           String   @id @default(cuid())
  cadenciaId   String
  ordem        Int
  /// dias após o início da cadência
  diaOffset    Int      @default(0)
  canal        Canal
  templateId   String?
  instrucoes   String?
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  cadencia   Cadencia          @relation(fields: [cadenciaId], references: [id], onDelete: Cascade)
  template   TemplateMensagem? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  interacoes Interacao[]
  tarefas    Tarefa[]

  @@unique([cadenciaId, ordem])
  @@map("passos_cadencia")
}

/// Variáveis suportadas: {{nome_ej}} {{nome_contato}} {{cargo}} {{ies}} {{cidade}} {{nome_sdr}}.
/// `assunto` só faz sentido em EMAIL. Desative (ativo = false) em vez de apagar.
model TemplateMensagem {
  id           String   @id @default(cuid())
  nome         String
  /// chave estável dos templates do seed (idempotência sem sobrescrever edições); null = criado na UI
  chave        String?  @unique
  canal        Canal
  assunto      String?
  corpo        String
  variaveis    String[] @default([])
  ativo        Boolean  @default(true)
  criadoPorId  String?
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  criadoPor Usuario?        @relation(fields: [criadoPorId], references: [id], onDelete: SetNull)
  passos    PassoCadencia[]

  /// seletor de template por canal no editor de passos
  @@index([canal, ativo])
  @@map("templates_mensagem")
}

model ListaSalva {
  id            String   @id @default(cuid())
  nome          String
  descricao     String?
  filtros       Json
  compartilhada Boolean  @default(false)
  donoId        String
  criadoEm      DateTime @default(now())
  atualizadoEm  DateTime @updatedAt

  dono Usuario @relation(fields: [donoId], references: [id], onDelete: Cascade)

  /// consulta típica: donoId = :eu OR compartilhada = true (BitmapOr)
  @@index([donoId])
  @@index([compartilhada])
  @@map("listas_salvas")
}

model Importacao {
  id                   String               @id @default(cuid())
  tipo                 TipoImportacao
  status               StatusImportacao     @default(AGUARDANDO_MAPEAMENTO)
  arquivoNome          String
  arquivoMime          String?
  arquivoTamanho       Int                  @default(0)
  /// sha256 do conteúdo (detectar reenvio do mesmo arquivo)
  arquivoHash          String?
  /// { colunaDoArquivo: campoDoSistema | null }
  mapeamento           Json?
  estrategiaDuplicados EstrategiaDuplicados @default(IGNORAR)
  totalLinhas          Int                  @default(0)
  processadas          Int                  @default(0)
  importadas           Int                  @default(0)
  atualizadas          Int                  @default(0)
  ignoradas            Int                  @default(0)
  erros                Int                  @default(0)
  /// [{ linha, campo?, mensagem, valores? }] — base do relatório baixável
  relatorioErros       Json?
  /// falha fatal do job (status FALHOU)
  mensagemErro         String?
  jobId                String?
  usuarioId            String?
  criadoEm             DateTime             @default(now())
  atualizadoEm         DateTime             @updatedAt
  iniciadaEm           DateTime?
  concluidaEm          DateTime?

  usuario Usuario?           @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  arquivo ImportacaoArquivo?

  @@index([criadoEm])
  @@index([usuarioId, criadoEm])
  @@map("importacoes")
}

/// Conteúdo bruto do arquivo importado (bytea, máx. 10 MB via CHECK). Tabela separada para que
/// listagens de Importacao nunca carreguem o binário; pode ser apagada após o processamento.
model ImportacaoArquivo {
  importacaoId String   @id
  conteudo     Bytes
  criadoEm     DateTime @default(now())

  importacao Importacao @relation(fields: [importacaoId], references: [id], onDelete: Cascade)

  @@map("importacoes_arquivos")
}

/// Configuração global do score de ICP (linha única, id = "default"; só ADMIN edita).
/// score = round(100 × Σ pontos / Σ pesos dos critérios ATIVOS); faixa: ≥limiarA → A, ≥limiarB → B,
/// ≥limiarC → C, senão D. CHECK no banco: 0 ≤ limiarC < limiarB < limiarA ≤ 100.
model ConfigScore {
  id              String   @id @default("default")
  limiarA         Int      @default(75)
  limiarB         Int      @default(50)
  limiarC         Int      @default(25)
  /// incrementar a cada mudança de pesos/parâmetros/limiares — dispara o recálculo em massa
  versao          Int      @default(1)
  atualizadoPorId String?
  criadoEm        DateTime @default(now())
  atualizadoEm    DateTime @updatedAt

  atualizadoPor Usuario? @relation(fields: [atualizadoPorId], references: [id], onDelete: SetNull)

  @@map("config_score")
}

/// Critério do score (um por chave). pontos do critério ∈ [0, peso]; `parametros` por chave:
///  FEDERADA {} · FAIXA_MEMBROS { faixas: [{ min, max|null, percentual }] } (percentual do peso; sem dado = 0)
///  AREAS_ALINHADAS { tagIds: [] } · REGIAO_PRIORITARIA { regioes: [], ufs: [] }
///  IES_PUBLICA_PRIVADA { preferencia: "PUBLICA"|"PRIVADA"|null } · TEM_SITE_REDES { campos: [...], minimo }
///  TEM_DECISOR { cargos: [...] } (ignora contatos com opt-out/anonimizados) · INTERACAO_30D { dias }
///  DADOS_VERIFICADOS {}
/// Pesos: CHECK 0–100 no banco; soma = 100 validada na API.
model CriterioScore {
  id              String      @id @default(cuid())
  chave           CriterioIcp @unique
  nome            String
  descricao       String?
  peso            Int
  ativo           Boolean     @default(true)
  parametros      Json        @default("{}")
  ordem           Int         @default(0)
  atualizadoPorId String?
  criadoEm        DateTime    @default(now())
  atualizadoEm    DateTime    @updatedAt

  atualizadoPor Usuario? @relation(fields: [atualizadoPorId], references: [id], onDelete: SetNull)

  @@index([ativo, ordem])
  @@map("criterios_score")
}

model AuditLog {
  id         String   @id @default(cuid())
  usuarioId  String?
  acao       String
  entidade   String
  entidadeId String?
  dados      Json?
  /// IP de origem da requisição (Etapa 7: a API preenche a partir de req.ip; null em jobs/seed)
  ip         String?
  criadoEm   DateTime @default(now())

  usuario Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([entidade, entidadeId])
  /// lista sem filtro (ORDER BY criadoEm DESC) e retenção (DELETE WHERE criadoEm < corte)
  @@index([criadoEm])
  /// tela de AuditLog (Etapa 7): filtro por usuário/ação + período
  @@index([usuarioId, criadoEm])
  @@index([acao, criadoEm])
  @@map("audit_logs")
}

enum TipoSupressao {
  EMAIL
  TELEFONE
}

enum MotivoSupressao {
  OPT_OUT
  ANONIMIZACAO
}

/// Lista de supressão global (LGPD, Etapa 7): impede recontatar um titular que pediu opt-out ou foi
/// anonimizado, mesmo que o dado volte por importação/coleta. NUNCA guarda o valor em claro.
/// `hash` é calculado NA API: HMAC-SHA256(pepper, "<tipo>:<valor normalizado>") em hex minúsculo (64 chars),
/// pepper em env (SUPRESSAO_PEPPER — trocar o pepper invalida a lista; não trocar sem recalcular).
/// Normalização: EMAIL = trim + minúsculo; TELEFONE = só dígitos com DDI (ex.: 5511999998888), usado
/// tanto para `telefone` quanto para `whatsapp` do Contato.
/// No banco: CHECK hash ~ '^[0-9a-f]{64}$'.
model SupressaoContato {
  id           String          @id @default(cuid())
  tipo         TipoSupressao
  hash         String          @unique @db.Char(64)
  motivo       MotivoSupressao
  criadoPorId  String?
  criadoEm     DateTime        @default(now())
  atualizadoEm DateTime        @updatedAt

  criadoPor Usuario? @relation(fields: [criadoPorId], references: [id], onDelete: SetNull)

  @@index([criadoPorId])
  @@map("supressoes_contato")
}

enum AcaoOptOut {
  MARCADO
  DESMARCADO
}

/// Histórico append-only de opt-out (Etapa 7): Contato.optOut/optOutEm/optOutMotivo guardam só o estado atual;
/// cada marcação/desmarcação gera uma linha aqui, que não se perde ao desmarcar. Sem atualizadoEm (imutável).
/// Ao anonimizar o contato, a API zera `motivo` (pode conter dado pessoal) e mantém as linhas.
/// Backfill na migration etapa7: uma linha MARCADO por contato com optOut = true (criadoEm = optOutEm).
model HistoricoOptOut {
  id        String     @id @default(cuid())
  contatoId String
  acao      AcaoOptOut
  motivo    String?
  usuarioId String?
  criadoEm  DateTime   @default(now())

  contato Contato  @relation(fields: [contatoId], references: [id], onDelete: Cascade)
  usuario Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([contatoId, criadoEm])
  @@index([usuarioId])
  @@map("historico_opt_out")
}

/// Meta semanal de interações e reuniões (Etapa 6; só ADMIN configura). Versionada por vigência para que
/// semanas passadas sejam avaliadas com a meta da época (conquista SEMANA_META_BATIDA).
/// Meta efetiva do SDR na semana S (segunda-feira, semana ISO em America/Sao_Paulo):
///   a linha com usuarioId = SDR e maior vigenteDesde ≤ S; se não houver, a GLOBAL (usuarioId null) com
///   maior vigenteDesde ≤ S. Ou seja: padrão global + override opcional por SDR.
/// Contagem: interações = Interacao do SDR (usuarioId) com data na semana (qualquer canal/resultado);
///   reuniões = as que têm resultado = REUNIAO_MARCADA (em qualquer canal). Interações no canal REUNIAO
///   (reunião realizada) contam como interação, NÃO como reunião — senão a mesma reunião contaria duas vezes
///   (ao marcar e ao realizar).
/// No banco: CHECK metas ≥ 0 e vigenteDesde numa segunda-feira; único parcial (vigenteDesde) WHERE usuarioId IS NULL.
model MetaSemanal {
  id               String   @id @default(cuid())
  /// null = padrão global do time
  usuarioId        String?
  interacoesSemana Int
  reunioesSemana   Int
  /// segunda-feira da primeira semana ISO em que a meta vale
  vigenteDesde     DateTime @db.Date
  definidoPorId    String?
  criadoEm         DateTime @default(now())
  atualizadoEm     DateTime @updatedAt

  usuario     Usuario? @relation("MetaDoUsuario", fields: [usuarioId], references: [id], onDelete: Cascade)
  definidoPor Usuario? @relation("MetaDefinidaPor", fields: [definidoPorId], references: [id], onDelete: SetNull)

  /// uma versão por SDR e semana; para a global (NULL) vale o único parcial criado na migration
  @@unique([usuarioId, vigenteDesde])
  @@index([definidoPorId])
  @@map("metas_semanais")
}

/// Definição de conquista (catálogo; seed cria as iniciais sem sobrescrever edições). A regra de concessão é
/// código, identificada pela `chave` — desative (ativa = false) em vez de apagar (FK Restrict).
model Conquista {
  id           String   @id @default(cuid())
  /// chave estável usada pelo código (ex.: PRIMEIRA_REUNIAO)
  chave        String   @unique
  nome         String
  descricao    String
  /// nome do ícone (lucide-react) — opcional
  icone        String?
  /// pode ser concedida mais de uma vez (uma por `referencia` em ConquistaUsuario)
  repetivel    Boolean  @default(false)
  ativa        Boolean  @default(true)
  ordem        Int      @default(0)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  concessoes ConquistaUsuario[]

  @@index([ativa, ordem])
  @@map("conquistas")
}

/// Conquista obtida por um usuário. `referencia` distingue repetíveis e torna a concessão idempotente
/// (INSERT ... ON CONFLICT DO NOTHING / createMany skipDuplicates):
///   ''            → não repetível (PRIMEIRA_REUNIAO, PRIMEIRA_OPORTUNIDADE, CEM_INTERACOES)
///   '2026-W47'    → semana ISO (SEMANA_META_BATIDA; CHECK de formato no banco)
///   federacaoId   → DEZ_EJS_FEDERACAO_NOVA (uma por federação)
/// `dados`: contexto da concessão (ex.: { interacaoId }, { semana, interacoes, reunioes, meta }, { federacaoId, ejs }).
model ConquistaUsuario {
  id             String   @id @default(cuid())
  usuarioId      String
  conquistaChave String
  referencia     String   @default("")
  conquistadaEm  DateTime @default(now())
  dados          Json?
  criadoEm       DateTime @default(now())
  atualizadoEm   DateTime @updatedAt

  usuario   Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  conquista Conquista @relation(fields: [conquistaChave], references: [chave], onDelete: Restrict, onUpdate: Cascade)

  /// idempotência da concessão; também serve "conquistas do usuário" (usuarioId = :id)
  @@unique([usuarioId, conquistaChave, referencia])
  /// feed "conquistas recentes do time" (ORDER BY conquistadaEm DESC LIMIT n)
  @@index([conquistadaEm(sort: Desc)])
  /// FK Restrict / "quem já tem a conquista X"
  @@index([conquistaChave])
  @@map("conquistas_usuarios")
}

// Orce'estra Prospect — schema completo (Etapa 1 já prevê as entidades das próximas etapas).

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Papel {
  ADMIN
  GESTOR
  SDR
}

enum Regiao {
  NORTE
  NORDESTE
  CENTRO_OESTE
  SUDESTE
  SUL
}

/// Funil (Etapa 3). PERDIDA exige motivoPerdaId; NUTRICAO exige dataRetornoNutricao (validado na API).
enum StatusProspeccao {
  NAO_TRABALHADA
  PESQUISADA
  PRIMEIRO_CONTATO
  EM_CONVERSA
  REUNIAO_AGENDADA
  OPORTUNIDADE
  PERDIDA
  NUTRICAO
}

enum TipoTag {
  AREA
  CURSO
  LIVRE
}

/// Canal de interação e de passo de cadência (mesmo enum: o passo gera a interação no seu canal).
/// OUTRO existe por compatibilidade com cadências/templates; a API de interações aceita só os 7 primeiros.
enum Canal {
  EMAIL
  WHATSAPP
  LIGACAO
  LINKEDIN
  INSTAGRAM
  REUNIAO
  OUTRO
  EVENTO
}

/// Resultado da interação (base da "taxa de resposta por canal": tudo ≠ SEM_RESPOSTA conta como resposta).
enum ResultadoInteracao {
  SEM_RESPOSTA
  RESPONDEU
  REUNIAO_MARCADA
  NAO_INTERESSADO
  OUTRO
}

enum OrigemTarefa {
  MANUAL
  INTERACAO
  MANDATO_VENCENDO
  NUTRICAO_RETORNO
  CADENCIA
}

enum StatusImportacao {
  /// arquivo recebido; aguardando mapeamento de colunas / pré-visualização / confirmação
  AGUARDANDO_MAPEAMENTO
  /// confirmada e enfileirada no BullMQ
  PENDENTE
  PROCESSANDO
  CONCLUIDA
  FALHOU
  CANCELADA
}

enum TipoImportacao {
  EJS
  CONTATOS
}

enum EstrategiaDuplicados {
  /// atualiza só campos vazios/novos do registro existente
  MESCLAR
  /// mantém o registro existente intacto e conta a linha como ignorada
  IGNORAR
}

enum CargoContato {
  PRESIDENTE
  DIR_GENTE_GESTAO
  DIR_COMERCIAL
  DIR_PROJETOS
  OUTRO
}

/// Bases legais da LGPD (art. 7º) aplicáveis a contatos B2B
enum BaseLegal {
  LEGITIMO_INTERESSE_B2B
  CONSENTIMENTO
  EXECUCAO_CONTRATO
  OBRIGACAO_LEGAL
}

/// Faixa do score de ICP (Etapa 4). Limiares configuráveis em ConfigScore.
enum FaixaIcp {
  A
  B
  C
  D
}

/// Natureza administrativa da IES. null = desconhecida (nada inventado).
enum NaturezaIes {
  PUBLICA
  PRIVADA
}

/// Chave estável dos critérios do score (o cálculo é código; adicionar critério exige migration + código).
enum CriterioIcp {
  FEDERADA
  FAIXA_MEMBROS
  AREAS_ALINHADAS
  REGIAO_PRIORITARIA
  IES_PUBLICA_PRIVADA
  TEM_SITE_REDES
  TEM_DECISOR
  INTERACAO_30D
  DADOS_VERIFICADOS
}

model Usuario {
  id            String    @id @default(cuid())
  nome          String
  email         String    @unique
  senhaHash     String
  papel         Papel     @default(SDR)
  ativo         Boolean   @default(true)
  ultimoLoginEm DateTime?
  criadoEm      DateTime  @default(now())
  atualizadoEm  DateTime  @updatedAt

  refreshTokens       RefreshToken[]
  tokensRedefinicao   TokenRedefinicaoSenha[]
  empresasResponsavel EmpresaJunior[]         @relation("ResponsavelEj")
  interacoes          Interacao[]
  tarefasResponsavel  Tarefa[]                @relation("TarefaResponsavel")
  tarefasCriadas      Tarefa[]                @relation("TarefaCriador")
  historicoStatus     HistoricoStatus[]
  cadencias           Cadencia[]
  templates           TemplateMensagem[]
  listas              ListaSalva[]
  importacoes         Importacao[]
  auditLogs           AuditLog[]
  configScore         ConfigScore[]
  criteriosScore      CriterioScore[]

  @@map("usuarios")
}

model RefreshToken {
  id         String    @id @default(cuid())
  usuarioId  String
  tokenHash  String    @unique
  expiraEm   DateTime
  revogadoEm DateTime?
  criadoEm   DateTime  @default(now())
  userAgent  String?

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@map("refresh_tokens")
}

model TokenRedefinicaoSenha {
  id        String    @id @default(cuid())
  usuarioId String
  tokenHash String    @unique
  expiraEm  DateTime
  usadoEm   DateTime?
  criadoEm  DateTime  @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@map("tokens_redefinicao_senha")
}

model Federacao {
  id           String   @id @default(cuid())
  nome         String
  sigla        String   @unique
  uf           String?  @db.Char(2)
  site         String?
  instagram    String?
  fonteUrl     String?
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  nucleos  Nucleo[]
  empresas EmpresaJunior[]

  @@map("federacoes")
}

model Nucleo {
  id           String   @id @default(cuid())
  nome         String
  federacaoId  String?
  cidade       String?
  uf           String?  @db.Char(2)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  federacao Federacao?      @relation(fields: [federacaoId], references: [id])
  empresas  EmpresaJunior[]

  @@unique([nome, federacaoId])
  @@map("nucleos")
}

model Ies {
  id           String   @id @default(cuid())
  nome         String
  /// nome normalizado + UF — usado para deduplicar
  chave        String   @unique
  sigla        String?
  cidade       String?
  uf           String?      @db.Char(2)
  /// pública/privada (critério IES_PUBLICA_PRIVADA); preenchido pelo coletor ou edição, nunca deduzido
  natureza     NaturezaIes?
  criadoEm     DateTime     @default(now())
  atualizadoEm DateTime     @updatedAt

  empresas EmpresaJunior[]

  @@index([uf])
  @@map("ies")
}

model EmpresaJunior {
  id                    String           @id @default(cuid())
  nome                  String
  nomeNormalizado       String
  /// CNPJ ou nome+IES+UF normalizados (idempotência do seed / deduplicação)
  chaveDedupe           String           @unique
  razaoSocial           String?
  cnpj                  String?          @unique @db.Char(14)
  iesId                 String?
  federacaoId           String?
  nucleoId              String?
  cidade                String?
  uf                    String?          @db.Char(2)
  regiao                Regiao?
  servicos              String[]         @default([])
  anoFundacao           Int?
  membrosEstimados      Int?
  federada              Boolean          @default(false)
  site                  String?
  instagram             String?
  linkedin              String?
  facebook              String?
  emailInstitucional    String?
  telefoneInstitucional String?
  situacaoCadastral     String?
  idBrasilJunior        String?
  fonteUrl              String
  fontes                String[]         @default([])
  coletadoEm            DateTime
  verificado            Boolean          @default(false)
  statusProspeccao      StatusProspeccao @default(NAO_TRABALHADA)
  /// última mudança de status (tempo na etapa atual); backfill = criadoEm
  statusAlteradoEm      DateTime         @default(now())
  /// obrigatório quando status = PERDIDA (validado na API)
  motivoPerdaId         String?
  motivoPerdaDetalhe    String?
  /// obrigatório quando status = NUTRICAO; o job diário gera tarefa NUTRICAO_RETORNO
  dataRetornoNutricao   DateTime?        @db.Date
  /// 0–100 (CHECK no banco). Calculado pelo job de score; 0 + faixaIcp null = ainda não calculado
  scoreIcp              Int              @default(0)
  /// null = score ainda não calculado
  faixaIcp              FaixaIcp?
  /// [{ chave, nome, peso, pontos, motivo }] — explicação exibida na página da EJ
  scoreDetalhe          Json?
  scoreCalculadoEm      DateTime?
  /// ConfigScore.versao usada no cálculo; recálculo em massa = WHERE scoreVersao IS DISTINCT FROM versao atual
  scoreVersao           Int?
  responsavelId         String?
  observacoes           String?
  criadoEm              DateTime         @default(now())
  atualizadoEm          DateTime         @updatedAt

  ies             Ies?              @relation(fields: [iesId], references: [id])
  federacao       Federacao?        @relation(fields: [federacaoId], references: [id])
  nucleo          Nucleo?           @relation(fields: [nucleoId], references: [id])
  responsavel     Usuario?          @relation("ResponsavelEj", fields: [responsavelId], references: [id])
  motivoPerda     MotivoPerda?      @relation(fields: [motivoPerdaId], references: [id], onDelete: Restrict)
  tags            Tag[]
  contatos        Contato[]
  interacoes      Interacao[]
  tarefas         Tarefa[]
  historicoStatus HistoricoStatus[]

  @@index([uf])
  @@index([motivoPerdaId])
  /// job diário de retorno de nutrição
  @@index([dataRetornoNutricao])
  @@index([regiao])
  @@index([federacaoId])
  @@index([iesId])
  @@index([nucleoId])
  @@index([nomeNormalizado])
  @@index([statusProspeccao])
  /// carteira do SDR / "sem responsável" (IS NULL) / carga por UF no rodízio
  @@index([responsavelId, uf])
  @@index([scoreIcp(sort: Desc), nome])
  /// filtro por faixa ordenado por score
  @@index([faixaIcp, scoreIcp(sort: Desc)])
  /// "Prioridades da semana": responsavelId = :sdr AND statusProspeccao = NAO_TRABALHADA ORDER BY scoreIcp DESC LIMIT n
  @@index([responsavelId, statusProspeccao, scoreIcp(sort: Desc)])
  @@index([membrosEstimados])
  /// busca por trecho (ILIKE '%...%') — requer extensão pg_trgm (criada na migration etapa2)
  @@index([nome(ops: raw("gin_trgm_ops"))], type: Gin, map: "empresas_juniores_nome_trgm_idx")
  @@index([nomeNormalizado(ops: raw("gin_trgm_ops"))], type: Gin, map: "empresas_juniores_nomeNormalizado_trgm_idx")
  @@index([razaoSocial(ops: raw("gin_trgm_ops"))], type: Gin, map: "empresas_juniores_razaoSocial_trgm_idx")
  @@map("empresas_juniores")
}

model Tag {
  id       String   @id @default(cuid())
  nome     String
  tipo     TipoTag  @default(LIVRE)
  /// tipo + nome normalizado
  chave    String   @unique
  cor      String?
  criadoEm DateTime @default(now())

  empresas EmpresaJunior[]

  @@map("tags")
}

/// Pessoas de contato das EJs (LGPD: toda linha tem base legal e fonte; opt-out bloqueia o uso).
model Contato {
  id              String       @id @default(cuid())
  empresaJuniorId String
  nome            String
  cargo           CargoContato @default(OUTRO)
  /// texto livre quando cargo = OUTRO (ou detalhe do cargo)
  cargoDescricao  String?
  /// sempre minúsculo/trim (normalizado na aplicação)
  email           String?
  telefone        String?
  whatsapp        String?
  linkedin        String?
  principal       Boolean      @default(false)
  mandatoInicio   DateTime?    @db.Date
  mandatoFim      DateTime?    @db.Date
  baseLegal       BaseLegal    @default(LEGITIMO_INTERESSE_B2B)
  /// de onde veio o dado (URL, "importação <id>", "manual", ...)
  fonte           String?
  optOut          Boolean      @default(false)
  optOutEm        DateTime?
  optOutMotivo    String?
  /// LGPD: preenchido quando os dados pessoais foram anonimizados (Etapa 7)
  anonimizadoEm   DateTime?
  criadoEm        DateTime     @default(now())
  atualizadoEm    DateTime     @updatedAt

  empresaJunior EmpresaJunior @relation(fields: [empresaJuniorId], references: [id], onDelete: Cascade)
  interacoes    Interacao[]
  tarefas       Tarefa[]

  @@index([empresaJuniorId])
  /// alertas de mandato vencendo (Etapa 3)
  @@index([mandatoFim])
  /// deduplicação na importação de contatos / busca por e-mail
  @@index([email])
  @@map("contatos")
}

/// Motivos de perda (lista configurável pelo ADMIN). Desative em vez de apagar (FK Restrict).
model MotivoPerda {
  id           String   @id @default(cuid())
  nome         String   @unique
  /// chave estável dos motivos do seed (idempotência sem sobrescrever renomeações); null = criado na UI
  chave        String?  @unique
  ativo        Boolean  @default(true)
  ordem        Int      @default(0)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  empresas        EmpresaJunior[]
  historicoStatus HistoricoStatus[]

  @@index([ativo, ordem])
  @@map("motivos_perda")
}

/// Toda mudança de status da EJ (timeline e "tempo médio por etapa"). Imutável: só criadoEm.
model HistoricoStatus {
  id              String            @id @default(cuid())
  empresaJuniorId String
  /// null = estado inicial (cadastro)
  de              StatusProspeccao?
  para            StatusProspeccao
  usuarioId       String?
  /// texto livre (ex.: detalhe da perda, origem "kanban"/"massa")
  motivo          String?
  motivoPerdaId   String?
  criadoEm        DateTime          @default(now())

  empresaJunior EmpresaJunior @relation(fields: [empresaJuniorId], references: [id], onDelete: Cascade)
  usuario       Usuario?      @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  motivoPerda   MotivoPerda?  @relation(fields: [motivoPerdaId], references: [id], onDelete: Restrict)

  @@index([empresaJuniorId, criadoEm])
  @@index([para, criadoEm])
  @@index([motivoPerdaId])
  @@map("historico_status")
}

model Interacao {
  id               String             @id @default(cuid())
  empresaJuniorId  String
  contatoId        String?
  usuarioId        String?
  canal            Canal
  data             DateTime           @default(now())
  resumo           String?
  resultado        ResultadoInteracao @default(SEM_RESPOSTA)
  proximoPasso     String?
  proximoPassoData DateTime?
  /// tarefa criada a partir do próximo passo (1:1)
  tarefaId         String?            @unique
  passoCadenciaId  String?
  criadoEm         DateTime           @default(now())
  atualizadoEm     DateTime           @updatedAt

  empresaJunior EmpresaJunior  @relation(fields: [empresaJuniorId], references: [id], onDelete: Cascade)
  contato       Contato?       @relation(fields: [contatoId], references: [id], onDelete: SetNull)
  usuario       Usuario?       @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  tarefa        Tarefa?        @relation("TarefaDaInteracao", fields: [tarefaId], references: [id], onDelete: SetNull)
  passoCadencia PassoCadencia? @relation(fields: [passoCadenciaId], references: [id], onDelete: SetNull)

  @@index([empresaJuniorId, data])
  @@index([usuarioId, data])
  @@index([canal, data])
  @@map("interacoes")
}

model Tarefa {
  id                String       @id @default(cuid())
  titulo            String
  descricao         String?
  vencimento        DateTime
  concluida         Boolean      @default(false)
  concluidaEm       DateTime?
  adiadaVezes       Int          @default(0)
  origem            OrigemTarefa @default(MANUAL)
  /// idempotência dos jobs (ex.: "mandato:<contatoId>:<mandatoFim>", "nutricao:<ejId>:<data>")
  chaveIdempotencia String?      @unique
  responsavelId     String
  empresaJuniorId   String?
  contatoId         String?
  criadoPorId       String?
  passoCadenciaId   String?
  criadoEm          DateTime     @default(now())
  atualizadoEm      DateTime     @updatedAt

  /// usuários são desativados, não apagados — Restrict evita perder a agenda
  responsavel   Usuario        @relation("TarefaResponsavel", fields: [responsavelId], references: [id], onDelete: Restrict)
  empresaJunior EmpresaJunior? @relation(fields: [empresaJuniorId], references: [id], onDelete: Cascade)
  contato       Contato?       @relation(fields: [contatoId], references: [id], onDelete: SetNull)
  criadoPor     Usuario?       @relation("TarefaCriador", fields: [criadoPorId], references: [id], onDelete: SetNull)
  passoCadencia PassoCadencia? @relation(fields: [passoCadenciaId], references: [id], onDelete: SetNull)
  interacao     Interacao?     @relation("TarefaDaInteracao")

  /// "Minha agenda" (hoje/atrasadas/7 dias) e contador de atrasadas
  @@index([responsavelId, concluida, vencimento])
  /// timeline da EJ
  @@index([empresaJuniorId, criadoEm])
  @@map("tarefas")
}

model Cadencia {
  id           String   @id @default(cuid())
  nome         String
  descricao    String?
  ativa        Boolean  @default(true)
  criadoPorId  String?
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  criadoPor Usuario?        @relation(fields: [criadoPorId], references: [id], onDelete: SetNull)
  passos    PassoCadencia[]

  @@map("cadencias")
}

model PassoCadencia {
  id           String   @id @default(cuid())
  cadenciaId   String
  ordem        Int
  /// dias após o início da cadência
  diaOffset    Int      @default(0)
  canal        Canal
  templateId   String?
  instrucoes   String?
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  cadencia   Cadencia          @relation(fields: [cadenciaId], references: [id], onDelete: Cascade)
  template   TemplateMensagem? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  interacoes Interacao[]
  tarefas    Tarefa[]

  @@unique([cadenciaId, ordem])
  @@map("passos_cadencia")
}

model TemplateMensagem {
  id           String   @id @default(cuid())
  nome         String
  canal        Canal
  assunto      String?
  corpo        String
  variaveis    String[] @default([])
  ativo        Boolean  @default(true)
  criadoPorId  String?
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  criadoPor Usuario?        @relation(fields: [criadoPorId], references: [id], onDelete: SetNull)
  passos    PassoCadencia[]

  @@map("templates_mensagem")
}

model ListaSalva {
  id            String   @id @default(cuid())
  nome          String
  descricao     String?
  filtros       Json
  compartilhada Boolean  @default(false)
  donoId        String
  criadoEm      DateTime @default(now())
  atualizadoEm  DateTime @updatedAt

  dono Usuario @relation(fields: [donoId], references: [id], onDelete: Cascade)

  /// consulta típica: donoId = :eu OR compartilhada = true (BitmapOr)
  @@index([donoId])
  @@index([compartilhada])
  @@map("listas_salvas")
}

model Importacao {
  id                   String               @id @default(cuid())
  tipo                 TipoImportacao
  status               StatusImportacao     @default(AGUARDANDO_MAPEAMENTO)
  arquivoNome          String
  arquivoMime          String?
  arquivoTamanho       Int                  @default(0)
  /// sha256 do conteúdo (detectar reenvio do mesmo arquivo)
  arquivoHash          String?
  /// { colunaDoArquivo: campoDoSistema | null }
  mapeamento           Json?
  estrategiaDuplicados EstrategiaDuplicados @default(IGNORAR)
  totalLinhas          Int                  @default(0)
  processadas          Int                  @default(0)
  importadas           Int                  @default(0)
  atualizadas          Int                  @default(0)
  ignoradas            Int                  @default(0)
  erros                Int                  @default(0)
  /// [{ linha, campo?, mensagem, valores? }] — base do relatório baixável
  relatorioErros       Json?
  /// falha fatal do job (status FALHOU)
  mensagemErro         String?
  jobId                String?
  usuarioId            String?
  criadoEm             DateTime             @default(now())
  atualizadoEm         DateTime             @updatedAt
  iniciadaEm           DateTime?
  concluidaEm          DateTime?

  usuario Usuario?           @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  arquivo ImportacaoArquivo?

  @@index([criadoEm])
  @@index([usuarioId, criadoEm])
  @@map("importacoes")
}

/// Conteúdo bruto do arquivo importado (bytea, máx. 10 MB via CHECK). Tabela separada para que
/// listagens de Importacao nunca carreguem o binário; pode ser apagada após o processamento.
model ImportacaoArquivo {
  importacaoId String   @id
  conteudo     Bytes
  criadoEm     DateTime @default(now())

  importacao Importacao @relation(fields: [importacaoId], references: [id], onDelete: Cascade)

  @@map("importacoes_arquivos")
}

/// Configuração global do score de ICP (linha única, id = "default"; só ADMIN edita).
/// score = round(100 × Σ pontos / Σ pesos dos critérios ATIVOS); faixa: ≥limiarA → A, ≥limiarB → B,
/// ≥limiarC → C, senão D. CHECK no banco: 0 ≤ limiarC < limiarB < limiarA ≤ 100.
model ConfigScore {
  id              String   @id @default("default")
  limiarA         Int      @default(75)
  limiarB         Int      @default(50)
  limiarC         Int      @default(25)
  /// incrementar a cada mudança de pesos/parâmetros/limiares — dispara o recálculo em massa
  versao          Int      @default(1)
  atualizadoPorId String?
  criadoEm        DateTime @default(now())
  atualizadoEm    DateTime @updatedAt

  atualizadoPor Usuario? @relation(fields: [atualizadoPorId], references: [id], onDelete: SetNull)

  @@map("config_score")
}

/// Critério do score (um por chave). pontos do critério ∈ [0, peso]; `parametros` por chave:
///  FEDERADA {} · FAIXA_MEMBROS { faixas: [{ min, max|null, percentual }] } (percentual do peso; sem dado = 0)
///  AREAS_ALINHADAS { tagIds: [] } · REGIAO_PRIORITARIA { regioes: [], ufs: [] }
///  IES_PUBLICA_PRIVADA { preferencia: "PUBLICA"|"PRIVADA"|null } · TEM_SITE_REDES { campos: [...], minimo }
///  TEM_DECISOR { cargos: [...] } (ignora contatos com opt-out/anonimizados) · INTERACAO_30D { dias }
///  DADOS_VERIFICADOS {}
/// Pesos: CHECK 0–100 no banco; soma = 100 validada na API.
model CriterioScore {
  id              String      @id @default(cuid())
  chave           CriterioIcp @unique
  nome            String
  descricao       String?
  peso            Int
  ativo           Boolean     @default(true)
  parametros      Json        @default("{}")
  ordem           Int         @default(0)
  atualizadoPorId String?
  criadoEm        DateTime    @default(now())
  atualizadoEm    DateTime    @updatedAt

  atualizadoPor Usuario? @relation(fields: [atualizadoPorId], references: [id], onDelete: SetNull)

  @@index([ativo, ordem])
  @@map("criterios_score")
}

model AuditLog {
  id         String   @id @default(cuid())
  usuarioId  String?
  acao       String
  entidade   String
  entidadeId String?
  dados      Json?
  ip         String?
  criadoEm   DateTime @default(now())

  usuario Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([entidade, entidadeId])
  @@index([criadoEm])
  @@map("audit_logs")
}

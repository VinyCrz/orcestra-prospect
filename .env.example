# ============================================================
# Orce'estra Prospect — variáveis de ambiente (copie para .env)
# ============================================================

# --- PostgreSQL ---
POSTGRES_USER=orcestra
POSTGRES_PASSWORD=orcestra
POSTGRES_DB=orcestra_prospect
POSTGRES_PORT=5432
# Para rodar a API fora do Docker (pnpm dev). Dentro do compose, a API usa o host "postgres".
DATABASE_URL=postgresql://orcestra:orcestra@localhost:5432/orcestra_prospect?schema=public

# --- Redis (BullMQ) ---
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- API (NestJS) ---
NODE_ENV=development
API_PORT=3001
# Gere com: openssl rand -base64 48
JWT_ACCESS_SECRET=troque-este-segredo-por-um-valor-aleatorio-longo
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DIAS=7
# true em produção (HTTPS)
COOKIE_SECURE=false
# URL pública do front (usada no link de "esqueci minha senha")
WEB_URL=http://localhost:3000
# Origens permitidas no CORS (separadas por vírgula). VAZIO (padrão) = CORS desligado: o navegador só fala
# com a API pelo proxy do web (/api/*, mesma origem). Só preencha se algum cliente externo precisar.
CORS_ORIGINS=
# Pepper do HMAC da lista de supressão LGPD (e-mails/telefones em opt-out/anonimizados, só hashes).
# Gere com: openssl rand -hex 32. OBRIGATÓRIO em produção (API não sobe sem); em dev, sem ele a API avisa
# e usa um valor fixo de desenvolvimento. NÃO TROQUE depois de usar: invalida a lista (rode o backfill se trocar).
SUPRESSAO_PEPPER=
# Só no deploy com front e API em provedores diferentes (docs/deploy.md): mesmo valor no web e na API.
# Gere com: openssl rand -hex 32. Vazio = desligado.
PROXY_SECRET=
# Rate limit (por minuto): login por IP+e-mail; refresh/esqueci-senha/redefinir-senha por IP
RATE_LIMIT_LOGIN_POR_MIN=5
RATE_LIMIT_AUTH_POR_MIN=10

# --- Web (Next.js) ---
WEB_PORT=3000
# URL que o servidor Next usa para alcançar a API (proxy /api/* -> API)
API_INTERNAL_URL=http://localhost:3001

# --- ADMIN inicial (criado pelo pnpm db:seed) ---
ADMIN_NOME=Administrador
ADMIN_EMAIL=admin@orcestra.com.br
ADMIN_SENHA=TroqueEstaSenha123!
